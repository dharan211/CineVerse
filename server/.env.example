# ============================================================
# CineVerse - server environment variables (EXAMPLE)
#
# Copy this file to `.env` and fill in your own values:
#
#   cp .env.example .env
#
# The real .env is gitignored, so your secrets never reach the repo.
# ============================================================

# Port the Express API runs on.
PORT=5000

# Your MongoDB Atlas connection string.
# Create a free cluster at https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cineverse

# Random long string used to sign JWTs. Any text works, but make it long
# and not your real password.
JWT_SECRET=change-this-to-a-long-random-string

# TMDB credential. Either of these works - the server detects which one
# it is and sends it the right way:
#   - v4 Read Access Token (JWT starting with "eyJ...")  -> sent as Bearer
#   - v3 API Key (32 hex chars)                          -> sent as ?api_key=
# Get one at https://www.themoviedb.org/settings/api
TMDB_TOKEN=<paste-your-token-or-api-key>

# Host to use for TMDB requests.
# Some ISPs block "api.themoviedb.org" at the TLS layer (shows up as
# ECONNRESET). "api.tmdb.org" is the same API and is usually not filtered.
# The server tries this host first, then falls back automatically.
TMDB_API_HOST=api.tmdb.org
